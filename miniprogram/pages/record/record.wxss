.record-tip {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 40rpx;
}

.recorder-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 32rpx;
}

.record-btn {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #2563eb;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 32rpx rgba(37, 99, 235, 0.35);
}

.record-btn.recording {
  background: #ef4444;
  box-shadow: 0 12rpx 32rpx rgba(239, 68, 68, 0.35);
  animation: pulse 1.2s infinite;
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.06); }
}

.record-time {
  margin-top: 24rpx;
  font-size: 30rpx;
  color: #374151;
}

.record-wave {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 60rpx;
  margin-top: 16rpx;
}

.record-wave .bar {
  width: 8rpx;
  height: 20rpx;
  background: #2563eb;
  border-radius: 4rpx;
  animation: bounce 0.9s infinite ease-in-out;
}

.record-wave .bar:nth-child(2n) { animation-delay: 0.15s; height: 40rpx; }
.record-wave .bar:nth-child(3n) { animation-delay: 0.3s; height: 30rpx; }

@keyframes bounce {
  0%, 100% { transform: scaleY(0.4); }
  50% { transform: scaleY(1); }
}

.preview-row {
  display: flex;
  gap: 24rpx;
  justify-content: center;
  margin-top: 16rpx;
}

.tip-text {
  text-align: center;
  color: #2563eb;
  font-size: 26rpx;
  margin-top: 20rpx;
}

.picker-row {
  color: #1f2430;
}

.consent-row {
  margin-top: 28rpx;
}

.consent-label {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 26rpx;
  color: #4b5563;
}

.submit-btn {
  margin: 32rpx 0 20rpx;
}

.submit-btn.disabled {
  opacity: 0.6;
}

.legal-note {
  font-size: 22rpx;
  color: #9aa0b4;
  text-align: center;
  padding: 0 24rpx;
}
