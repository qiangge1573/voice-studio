.video-preview {
  width: 100%;
  border-radius: 16rpx;
  background: #0f172a;
}

.video-info {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.choose-btn {
  margin-top: 20rpx;
}

.picker-row {
  color: #1f2430;
}

.no-voice {
  padding: 24rpx 0;
  color: #6b7280;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.text-area {
  width: 100%;
  min-height: 220rpx;
  background: #f3f4f8;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
}

.script-hint {
  font-size: 23rpx;
  color: #9aa0b4;
  margin-top: 12rpx;
}

.mode-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.mode-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.mode-name {
  font-size: 29rpx;
  font-weight: 500;
}

.mode-desc {
  font-size: 24rpx;
  color: #9aa0b4;
}

.submit-btn {
  margin-bottom: 32rpx;
}

.submit-btn.disabled {
  opacity: 0.6;
}

.result-card .ai-label {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #9aa0b4;
  border: 2rpx solid #e5e7eb;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

.task-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f3f4f8;
}

.task-row:last-child {
  border-bottom: none;
}

.task-main {
  flex: 1;
  min-width: 0;
}

.task-name {
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-meta {
  font-size: 23rpx;
  color: #9aa0b4;
  margin-top: 6rpx;
}

.task-status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.task-status.done {
  background: #dcfce7;
  color: #16a34a;
}

.task-status.failed {
  background: #fee2e2;
  color: #ef4444;
}

.task-status.pending,
.task-status.running {
  background: #fef9c3;
  color: #ca8a04;
}
