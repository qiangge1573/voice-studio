<view class="page">
  <view class="card">
    <view class="card-title">① 选择视频</view>
    <video wx:if="{{videoPath}}" class="video-preview" src="{{videoPath}}" controls object-fit="contain" />
    <view class="video-info" wx:if="{{videoName}}">
      {{videoName}}{{sizeText ? '（' + sizeText + '）' : ''}}
    </view>
    <view class="btn-ghost choose-btn" bindtap="chooseVideo">
      {{videoPath ? '重新选择视频' : '从相册选择视频'}}
    </view>
  </view>

  <view class="card">
    <view class="card-title">② 选择音色</view>
    <block wx:if="{{voices.length === 0}}">
      <view class="no-voice">
        <view>还没有可用音色</view>
        <view class="btn-ghost" bindtap="goCreateVoice">去录制声音</view>
      </view>
    </block>
    <block wx:else>
      <picker range="{{voiceNames}}" value="{{voiceIndex}}" bindchange="onVoice">
        <view class="input-box picker-row">{{voiceNames[voiceIndex]}} ›</view>
      </picker>
    </block>
  </view>

  <view class="card">
    <view class="card-title">③ 配音台本</view>
    <textarea
      class="text-area"
      placeholder="每行一条。带时间戳从指定时间开始，否则顺序接续：&#10;[00:03] 大家好，欢迎收看本期节目&#10;[00:08] 今天我们要聊一个有趣的话题&#10;这段没有时间戳，会接在上一句后面"
      value="{{script}}"
      bindinput="onScript"
      maxlength="3000"
      auto-height
      show-confirm-bar="{{false}}"
    />
    <view class="script-hint">格式：[mm:ss] 文本（锚定时间）或 文本（顺序接续，首段从 0 开始）</view>
  </view>

  <view class="card">
    <view class="card-title">④ 混音方式</view>
    <radio-group bindchange="onMode" class="mode-group">
      <label class="mode-item">
        <radio value="overlay" checked="{{mode === 'overlay'}}" color="#2563eb" />
        <view class="mode-text">
          <view class="mode-name">配音叠加</view>
          <view class="mode-desc">压低原声，叠加配音（适合解说）</view>
        </view>
      </label>
      <label class="mode-item">
        <radio value="replace" checked="{{mode === 'replace'}}" color="#2563eb" />
        <view class="mode-text">
          <view class="mode-name">替换原音轨</view>
          <view class="mode-desc">完全用配音替换视频原声</view>
        </view>
      </label>
    </radio-group>
  </view>

  <view class="btn-primary submit-btn {{submitting ? 'disabled' : ''}}" bindtap="submit">
    {{submitting ? '配音中，请稍候…' : '开始配音'}}
  </view>

  <view class="card result-card" wx:if="{{videoUrl}}">
    <view class="card-title">配音结果</view>
    <video class="video-preview" src="{{videoUrl}}" controls object-fit="contain" />
    <view class="ai-label">AI 合成配音内容</view>
  </view>

  <view class="card" wx:if="{{tasks.length > 0}}">
    <view class="card-title">最近任务</view>
    <view class="task-row" wx:for="{{tasks}}" wx:key="task_id" bindtap="previewTask" data-url="{{item.video_url}}">
      <view class="task-main">
        <view class="task-name">{{item.voice_name}} · {{item.mode === 'replace' ? '替换原声' : '配音叠加'}}</view>
        <view class="task-meta">{{item.created_at_text}}</view>
      </view>
      <view class="task-status {{item.status}}">
        {{item.status === 'done' ? '完成' : (item.status === 'failed' ? '失败' : '处理中')}}
      </view>
    </view>
  </view>
</view>
