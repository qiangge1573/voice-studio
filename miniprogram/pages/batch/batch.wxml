<view class="page">
  <view class="card">
    <view class="card-title">选择音色</view>
    <block wx:if="{{voices.length === 0}}">
      <view class="no-voice">
        <view>还没有可用音色</view>
        <view class="btn-ghost" bindtap="goCreateVoice">去录制声音</view>
      </view>
    </block>
    <block wx:else>
      <picker range="{{voiceNames}}" value="{{voiceIndex}}" bindchange="onVoice">
        <view class="input-box picker-row">{{voiceNames[voiceIndex]}} ›</view>
      </picker>
    </block>
  </view>

  <view class="card">
    <view class="card-title">批量文本</view>
    <textarea
      class="text-area"
      placeholder="每行一条，批量合成：&#10;第一条文本&#10;第二条文本&#10;第三条文本"
      value="{{text}}"
      bindinput="onText"
      maxlength="10000"
      auto-height
      show-confirm-bar="{{false}}"
    />
    <view class="line-count">{{lineCount}} 行</view>
  </view>

  <view class="btn-primary synth-btn {{submitting ? 'disabled' : ''}}" bindtap="submit">
    {{submitting ? '合成中…' : '批量合成'}}
  </view>

  <view class="card result-card" wx:if="{{result}}">
    <view class="card-title">合成结果（{{result.items.length}} 条）</view>
    <view class="item-row" wx:for="{{result.items}}" wx:key="index">
      <view class="item-main">
        <view class="item-text">{{item.text}}</view>
        <view class="item-meta">
          <text class="item-status {{item.status}}">
            {{item.status === 'done' ? '完成' : (item.status === 'failed' ? '失败' : '处理中')}}
          </text>
          <text wx:if="{{item.error}}" class="item-error">{{item.error}}</text>
        </view>
      </view>
      <view
        class="item-play {{playingIndex === item.index ? 'active' : ''}}"
        wx:if="{{item.audio_url}}"
        catchtap="onPlay"
        data-index="{{item.index}}"
        data-url="{{item.audio_url}}"
      >
        {{playingIndex === item.index ? '停止' : '播放'}}
      </view>
    </view>
    <view class="ai-label">内容由 AI 合成</view>
  </view>

  <view class="card" wx:if="{{tasks.length > 0}}">
    <view class="card-title">最近任务</view>
    <view class="task-row" wx:for="{{tasks}}" wx:key="task_id">
      <view class="task-main">
        <view class="task-name">{{item.voice_name}} · {{item.items.length}} 条</view>
        <view class="task-meta">{{item.created_at_text}}</view>
      </view>
      <view class="task-status {{item.status}}">{{item.status === 'done' ? '完成' : (item.status === 'failed' ? '失败' : '处理中')}}</view>
    </view>
  </view>
</view>
