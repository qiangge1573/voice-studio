# 运行模式: cloud(默认, 火山引擎云TTS) | mock(占位音频联调) | xtts | cosyvoice
# 未配置 VOLC_API_KEY 时 cloud 自动回退 mock，配置后即为真实云合成
ENGINE=cloud

# 火山引擎 API Key（豆包语音）: 火山引擎控制台 -> 豆包语音 -> API Key 管理
# 获取地址 https://console.volcengine.com/speech/app 附近（新版控制台「API Key 管理」）
VOLC_API_KEY=

# 微信小程序凭据（mp.weixin.qq.com -> 开发管理 -> 开发设置）
# 留空或占位时服务端进入 dev_mode：登录接口接受 code=dev，方便本地联调
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 服务监听
HOST=0.0.0.0
PORT=8000

# 数据目录（语音样本 / 合成结果 / SQLite）
DATA_DIR=./data

# 登录令牌签名密钥（生产环境务必更换为随机长字符串）
JWT_SECRET=please-change-me-to-a-long-random-string

# 推理设备: cpu / cuda / mps
DEVICE=cpu

# CosyVoice 模型目录
COSYVOICE_MODEL_DIR=pretrained_models/CosyVoice2-0.5B
